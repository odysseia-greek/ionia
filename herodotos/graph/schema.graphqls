type Health {
  healthy: Boolean!
  time: String!
  version: String!
}

type Passage {
  greek: String!
  translations: [String!]!
  section: String!
}

type Text {
  author: String!
  book: String!
  type: String!
  reference: String!
  perseusTextLink: String!
  passages: [Passage!]!
}

input TextInput {
  author: String!
  book: String!
  reference: String
  section: String
}

type ReadingSession {
  id: ID!
  userId: String!
  formId: ID!
  form: Form!
  progressBlob: String!
  createdAt: String!
  updatedAt: String!
}

# Opaque form payload while the learning-form design is still evolving.
type Form {
  id: ID!
  blob: String!
}

input StartReadingInput {
  userId: String!
  formId: ID!
}

input SaveProgressInput { id: ID!, progressBlob: String! }

type CorpusReference { name: String!, sections: [String!]! }
type CorpusBook { name: String!, references: [CorpusReference!]! }
type CorpusAuthor { name: String!, books: [CorpusBook!]! }
type CorpusOptions { authors: [CorpusAuthor!]! }

input TranslationAnswerInput { section: String!, translation: String! }
input CheckTextInput { author: String!, book: String!, reference: String!, translations: [TranslationAnswerInput!]! }
type Typo { source: String!, provided: String! }
type AnswerSection { section: String!, levenshteinPercentage: String!, quizSentence: String!, answerSentence: String! }
type CheckTextResult { averageLevenshteinPercentage: String!, sections: [AnswerSection!]!, possibleTypos: [Typo!]! }

type Query {
  health: Health!
  corpusHealth: Health!
  corpusOptions: CorpusOptions!
  forms(size: Int = 20): [Form!]!
  form(id: ID!): Form!
  text(input: TextInput!): Text!
  reading(id: ID!): ReadingSession!
}

type Mutation {
  startReading(input: StartReadingInput!): ReadingSession!
  saveProgress(input: SaveProgressInput!): ReadingSession!
  checkText(input: CheckTextInput!): CheckTextResult!
}
