type Health {
  healthy: Boolean!
  time: String!
  version: String!
}

type Passage {
  greek: String!
  translations: [String!]!
  section: String!
}

type Text {
  author: String!
  book: String!
  type: String!
  reference: String!
  perseusTextLink: String!
  passages: [Passage!]!
}

input TextInput {
  author: String!
  book: String!
  reference: String
  section: String
}

type ChapterOption {
  chapter: String!
  title: String!
  order: Int!
  level: Int!
}

type ChapterOptions { chapters: [ChapterOption!]! }

type Chapter {
  chapter: String!
  title: String!
  order: Int!
  level: Int!
  blob: String!
  grammar: [Grammar!]!
  vocabulary: [Vocabulary!]!
  texts: [ChapterText!]!
}

type GrammarExample {
  greek: String!
  translation: String!
  note: String!
}

type Grammar {
  grammar: String!
  title: String!
  explanation: String!
  example: GrammarExample
}

type Vocabulary {
  greek: String!
  translation: String!
}

type ChapterTextSource {
  author: String!
  work: String!
  reference: String!
  dialect: String!
}

type ChapterText {
  text: String!
  title: String!
  type: String!
  source: ChapterTextSource!
  greek: String!
  readingHints: [String!]!
}

input ChapterAnswerInput {
  text: String!
  learnerText: String!
}

input CheckChapterInput {
  chapter: String!
  answers: [ChapterAnswerInput!]!
}

type CheckedChapterText {
  text: String!
  sourceText: String!
  actualText: String!
  learnerText: String!
}

type CheckChapterResult {
  chapter: String!
  texts: [CheckedChapterText!]!
}

type CorpusReference { name: String!, sections: [String!]! }
type CorpusBook { name: String!, references: [CorpusReference!]! }
type CorpusAuthor { name: String!, books: [CorpusBook!]! }
type CorpusOptions { authors: [CorpusAuthor!]! }

input TranslationAnswerInput { section: String!, translation: String! }
input CheckTextInput { author: String!, book: String!, reference: String!, translations: [TranslationAnswerInput!]! }
type Typo { source: String!, provided: String! }
type AnswerSection { section: String!, levenshteinPercentage: String!, quizSentence: String!, answerSentence: String! }
type CheckTextResult { averageLevenshteinPercentage: String!, sections: [AnswerSection!]!, possibleTypos: [Typo!]! }

type Query {
  health: Health!
  corpusHealth: Health!
  corpusOptions: CorpusOptions!
  chapterOptions: ChapterOptions!
  chapter(chapter: String!): Chapter!
  text(input: TextInput!): Text!
}

type Mutation {
  checkChapter(input: CheckChapterInput!): CheckChapterResult!
  checkText(input: CheckTextInput!): CheckTextResult!
}
